{
  "$defs": {
    "RoleConfig": {
      "additionalProperties": false,
      "description": "Write scope for one role. Globs are project-relative; deny wins over write.",
      "properties": {
        "description": {
          "default": "",
          "maxLength": 500,
          "title": "Description",
          "type": "string"
        },
        "write": {
          "items": {
            "maxLength": 300,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 200,
          "title": "Write",
          "type": "array"
        },
        "deny": {
          "items": {
            "maxLength": 300,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 200,
          "title": "Deny",
          "type": "array"
        }
      },
      "title": "RoleConfig",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "default": 1,
      "maximum": 1,
      "minimum": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "harness_version": {
      "const": "0.1.0",
      "default": "0.1.0",
      "title": "Harness Version",
      "type": "string"
    },
    "project_name": {
      "maxLength": 120,
      "minLength": 1,
      "title": "Project Name",
      "type": "string"
    },
    "description": {
      "default": "",
      "maxLength": 4000,
      "title": "Description",
      "type": "string"
    },
    "adapter": {
      "const": "claude-code",
      "default": "claude-code",
      "title": "Adapter",
      "type": "string"
    },
    "technologies": {
      "items": {
        "type": "string"
      },
      "title": "Technologies",
      "type": "array"
    },
    "roles": {
      "patternProperties": {
        "^[a-z][a-z0-9-]{0,39}$": {
          "$ref": "#/$defs/RoleConfig"
        }
      },
      "title": "Roles",
      "type": "object"
    }
  },
  "required": [
    "project_name"
  ],
  "title": "HarnessConfig",
  "type": "object"
}
