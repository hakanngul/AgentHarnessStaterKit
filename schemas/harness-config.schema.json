{
  "$defs": {
    "PhaseConfig": {
      "additionalProperties": false,
      "description": "One lifecycle phase. `requires` names phases a task must build on.",
      "properties": {
        "name": {
          "pattern": "^[a-z][a-z0-9-]{0,39}$",
          "title": "Name",
          "type": "string"
        },
        "description": {
          "default": "",
          "maxLength": 500,
          "title": "Description",
          "type": "string"
        },
        "requires": {
          "items": {
            "pattern": "^[a-z][a-z0-9-]{0,39}$",
            "type": "string"
          },
          "maxItems": 50,
          "title": "Requires",
          "type": "array"
        }
      },
      "required": [
        "name"
      ],
      "title": "PhaseConfig",
      "type": "object"
    },
    "RoleConfig": {
      "additionalProperties": false,
      "description": "Write scope for one role. Globs are project-relative; deny wins over write.",
      "properties": {
        "description": {
          "default": "",
          "maxLength": 500,
          "title": "Description",
          "type": "string"
        },
        "write": {
          "items": {
            "maxLength": 300,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 200,
          "title": "Write",
          "type": "array"
        },
        "deny": {
          "items": {
            "maxLength": 300,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 200,
          "title": "Deny",
          "type": "array"
        },
        "model": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:\\[\\]-]{0,99}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model"
        },
        "effort": {
          "anyOf": [
            {
              "enum": [
                "low",
                "medium",
                "high",
                "xhigh",
                "max"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Effort"
        },
        "bash": {
          "items": {
            "maxLength": 200,
            "minLength": 1,
            "pattern": "^[^\\s;&|<>`$()]+( [^\\s;&|<>`$()]+)*$",
            "type": "string"
          },
          "maxItems": 100,
          "title": "Bash",
          "type": "array"
        }
      },
      "title": "RoleConfig",
      "type": "object"
    },
    "WorkflowConfig": {
      "additionalProperties": false,
      "description": "Lifecycle phases enforced by `harness check` through task dependencies.",
      "properties": {
        "phases": {
          "items": {
            "$ref": "#/$defs/PhaseConfig"
          },
          "maxItems": 50,
          "minItems": 1,
          "title": "Phases",
          "type": "array"
        },
        "require_phase": {
          "default": false,
          "title": "Require Phase",
          "type": "boolean"
        }
      },
      "required": [
        "phases"
      ],
      "title": "WorkflowConfig",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "default": 1,
      "maximum": 1,
      "minimum": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "harness_version": {
      "const": "0.1.0",
      "default": "0.1.0",
      "title": "Harness Version",
      "type": "string"
    },
    "project_name": {
      "maxLength": 120,
      "minLength": 1,
      "title": "Project Name",
      "type": "string"
    },
    "description": {
      "default": "",
      "maxLength": 4000,
      "title": "Description",
      "type": "string"
    },
    "adapter": {
      "const": "claude-code",
      "default": "claude-code",
      "title": "Adapter",
      "type": "string"
    },
    "technologies": {
      "items": {
        "type": "string"
      },
      "title": "Technologies",
      "type": "array"
    },
    "roles": {
      "patternProperties": {
        "^[a-z][a-z0-9-]{0,39}$": {
          "$ref": "#/$defs/RoleConfig"
        }
      },
      "title": "Roles",
      "type": "object"
    },
    "workflow": {
      "anyOf": [
        {
          "$ref": "#/$defs/WorkflowConfig"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "required": [
    "project_name"
  ],
  "title": "HarnessConfig",
  "type": "object"
}
